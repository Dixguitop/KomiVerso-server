# Base de datos (la obtienes de Supabase o Neon, gratis)
DATABASE_URL="postgresql://usuario:password@host:5432/nombre_bd"

# Secreto para firmar los tokens de sesión (invéntate una cadena larga y aleatoria)
JWT_SECRET="cambia-esto-por-algo-largo-y-aleatorio"

# Configuración de correo (ejemplo con Gmail + contraseña de aplicación)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="tu_correo@gmail.com"
SMTP_PASS="tu_contraseña_de_aplicacion"

PORT=3001
